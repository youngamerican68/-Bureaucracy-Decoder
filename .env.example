# Bureaucracy Decoder - Environment Variables
# Copy this file to .env.local and fill in your credentials

# =============================================================================
# REQUIRED: Supabase Configuration
# =============================================================================
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# REQUIRED: OpenAI API Key (for embeddings)
# =============================================================================
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# =============================================================================
# REQUIRED: Anthropic API Key (for Claude LLM)
# =============================================================================
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# OPTIONAL: Firecrawl API Key (for better web scraping)
# =============================================================================
# Get from https://firecrawl.dev
# If not provided, falls back to basic HTTP fetch
FIRECRAWL_API_KEY=

# =============================================================================
# Setup Instructions
# =============================================================================
#
# 1. Create a Supabase project at https://supabase.com
#
# 2. Run the database schema:
#    - Go to SQL Editor in Supabase dashboard
#    - Run the contents of db/schema.sql
#
# 3. Enable the pgvector extension:
#    - In Supabase dashboard, go to Database > Extensions
#    - Enable "vector" extension
#
# 4. Seed the featured metros:
#    npm run seed
#
# 5. Ingest a metro's zoning code:
#    npx ts-node scripts/ingest-metro.ts los-angeles
#
# 6. Start the development server:
#    npm run dev
